# Copia este archivo como ".env.local" y completa los dos valores para conectar la aplicación a Supabase.
# Si se dejan vacíos, la aplicación funciona en MODO DEMOSTRACIÓN con datos ficticios.
#
# Ambos valores son PÚBLICOS por diseño (Supabase → Project Settings → API).
# NUNCA pongas aquí la llave "service_role": esa llave solo vive en el servidor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
